{$VIBEPAGE_DOMAIN} {
 tls {$TLS_EMAIL}
 @internalReadiness path /api/health /api/health/*
 respond @internalReadiness 404
 basic_auth {
  {$STAGING_BASIC_USER} {$STAGING_BASIC_PASSWORD_HASH}
 }
 request_body {
  max_size 5MB
 }
 reverse_proxy web:3000 {
  header_up X-VibePage-Client-IP {http.request.remote.host}
  transport http {
   dial_timeout 5s
   response_header_timeout 30s
  }
 }
 # Access logs are intentionally disabled: authentication URLs contain tokens.
 # Add only a reviewed/redacted logging policy; never log cookies, URI tokens or bodies.
}
