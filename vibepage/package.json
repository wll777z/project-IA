{
  "name": "vibepage",
  "version": "0.2.0",
  "description": "VibePage — MVP de perfis públicos, editor e estatísticas.",
  "scripts": {
    "test": "prisma generate && vitest run",
    "dev": "next dev",
    "build": "prisma generate && node scripts/build.mjs && node scripts/prepare-standalone.mjs",
    "start": "node --env-file-if-exists=.env .next/standalone/launch.mjs",
    "lint": "eslint .",
    "typecheck": "prisma generate && tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "db:cleanup": "node --import tsx scripts/cleanup.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "admin:plan": "node --import tsx scripts/entitlement.ts",
    "test:http": "node --import tsx tests/http-smoke.ts",
    "setup": "node scripts/setup.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@hookform/resolvers": "5.9.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "better-auth": "1.7.14",
    "dotenv": "18.0.9",
    "lucide-react": "1.61.0",
    "motion": "14.6.0",
    "next": "16.4.3",
    "nodemailer": "10.2.1",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.91.0",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.12",
    "@electric-sql/pglite-socket": "0.2.15",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.5",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "postcss": "8.5.32",
    "prettier": "3.9.10",
    "prisma": "7.10.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  },
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  }
}
