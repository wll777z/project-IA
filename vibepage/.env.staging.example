# Copy to .env.staging on the staging host; never commit secrets.
# Generate separate values with crypto.randomBytes(40).toString('base64url').
POSTGRES_PASSWORD=
BETTER_AUTH_SECRET=
# Must match the DNS domain below, e.g. https://staging.example.org
BETTER_AUTH_URL=
VIBEPAGE_DOMAIN=
TLS_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
STAGING_BASIC_USER=
# Generate interactively: docker run --rm -it caddy:2-alpine caddy hash-password
# Keep the bcrypt value single-quoted in this env file (contains $ characters).
STAGING_BASIC_PASSWORD_HASH=
# Enable intake only after legal/operator approval AND a verified administrator.
SUPPORT_INTAKE_ENABLED=false
SUPPORT_RETENTION_DAYS=
LEGAL_CONTROLLER_NAME=
LEGAL_CONTACT_EMAIL=
LEGAL_NOTICE_VERSION=
LEGAL_RETENTION_NOTICE=
LEGAL_AGE_NOTICE=
