generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Plan {
  FREE
  PRO
}

model User {
  id            String               @id
  name          String
  email         String               @unique
  emailVerified Boolean              @default(false)
  image         String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  sessions      Session[]
  accounts      Account[]
  profile       Profile?
  entitlement   Entitlement?
  uploads       Upload[]
  appearances   SavedAppearance[]
  schedules     AppearanceSchedule[]
  administrator Administrator?
  caseEvents    SupportCaseEvent[]
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@index([expiresAt])
}

model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt
}

model Profile {
  id                 String         @id @default(cuid())
  userId             String         @unique
  user               User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  username           String         @unique @db.VarChar(24)
  displayName        String         @db.VarChar(60)
  bio                String         @default("") @db.VarChar(240)
  avatarKey          String?
  backgroundKey      String?
  accentColor        String         @default("#a78bfa") @db.VarChar(7)
  revision           Int            @default(0)
  backgroundColor    String         @default("#100c1b") @db.VarChar(7)
  buttonStyle        String         @default("soft")
  animation          String         @default("none")
  hideBranding       Boolean        @default(false)
  published          Boolean        @default(false)
  themeId            String         @default("midnight-purple")
  theme              Theme          @relation(fields: [themeId], references: [id], onDelete: Restrict)
  backgroundEffect   String         @default("none")
  avatarEffect       String         @default("none")
  buttonEffect       String         @default("none")
  entranceEffect     String         @default("fade")
  fontFamily         String         @default("modern")
  studio             Json           @default("{\"layout\":\"classic\",\"columns\":1,\"width\":\"standard\",\"spacing\":\"normal\",\"cardColumns\":1,\"order\":[\"identity\",\"gamerCards\",\"links\",\"blocks\"],\"hidden\":[],\"widths\":{\"identity\":2,\"gamerCards\":2,\"links\":2,\"blocks\":2}}")
  previousAppearance Json?
  vibeCardStyle      String         @default("minimal")
  blocks             ProfileBlock[]
  gamerCards         GamerCard[]
  links              ProfileLink[]
  views              PageView[]
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  suspendedAt        DateTime?
  supportCases       SupportCase[]
}

model ProfileLink {
  id        String      @id @default(cuid())
  profileId String
  profile   Profile     @relation(fields: [profileId], references: [id], onDelete: Cascade)
  title     String      @db.VarChar(80)
  url       String      @db.VarChar(2048)
  clicks    LinkClick[]
  position  Int

  @@unique([profileId, position])
}

model Theme {
  id       String    @id
  name     String
  premium  Boolean   @default(false)
  profiles Profile[]
}

// Aggregate daily counts only: no visitor IPs, fingerprinting or location.
model PageView {
  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  day       DateTime @db.Date
  count     Int      @default(0)
  clicks    Int      @default(0)

  @@id([profileId, day])
  @@index([day])
}

// No billing provider or paid activation in stage 1. Missing entitlement = FREE.
model Entitlement {
  id        String    @id @default(cuid())
  userId    String    @unique
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan      Plan      @default(FREE)
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Upload {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String
  slot      Int      @default(0)
  content   Bytes
  mimeType  String   @default("image/webp")
  width     Int
  height    Int
  createdAt DateTime @default(now())

  @@unique([userId, kind, slot])
}

model LinkClick {
  linkId String
  link   ProfileLink @relation(fields: [linkId], references: [id], onDelete: Cascade)
  day    DateTime    @db.Date
  count  Int         @default(0)

  @@id([linkId, day])
  @@index([day])
}

model GamerCard {
  id          String      @id
  profileId   String
  profile     Profile     @relation(fields: [profileId], references: [id], onDelete: Cascade)
  game        String
  displayName String      @db.VarChar(60)
  handle      String      @default("") @db.VarChar(60)
  detail      String      @default("") @db.VarChar(100)
  edition     String      @default("")
  url         String      @default("") @db.VarChar(2048)
  avatarKey   String?
  color       String      @default("#a78bfa") @db.VarChar(7)
  style       String      @default("minimal")
  layout      String      @default("compact")
  icon        String      @default("gamepad")
  glow        Boolean     @default(false)
  animated    Boolean     @default(false)
  position    Int
  clicks      CardClick[]

  @@unique([profileId, position])
}

model ProfileBlock {
  id        String  @id
  profileId String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  payload   Json
  position  Int

  @@unique([profileId, position])
}

model SavedAppearance {
  id        String               @id
  userId    String
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String               @db.VarChar(60)
  config    Json
  revision  Int                  @default(0)
  createdAt DateTime             @default(now())
  schedules AppearanceSchedule[]

  @@index([userId, createdAt])
}

model AppearanceSchedule {
  id           String          @id
  userId       String
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  appearanceId String
  appearance   SavedAppearance @relation(fields: [appearanceId], references: [id], onDelete: Cascade)
  startsAt     DateTime        @db.Timestamptz(3)
  endsAt       DateTime        @db.Timestamptz(3)
  timeZone     String          @db.VarChar(80)
  createdAt    DateTime        @default(now())

  @@index([userId, startsAt, endsAt])
}

model CardClick {
  cardId String
  card   GamerCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  day    DateTime  @db.Date
  count  Int       @default(0)

  @@id([cardId, day])
  @@index([day])
}

model Administrator {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone     String   @db.VarChar(16)
  createdAt DateTime @default(now())
}

model SupportCase {
  id             String             @id
  kind           String             @db.VarChar(10)
  category       String             @db.VarChar(24)
  subject        String             @db.VarChar(120)
  message        String             @db.VarChar(2000)
  replyEmail     String?            @db.VarChar(254)
  targetUsername String?            @db.VarChar(24)
  profileId      String?
  profile        Profile?           @relation(fields: [profileId], references: [id], onDelete: SetNull)
  status         String             @default("OPEN") @db.VarChar(16)
  internalNote   String             @default("") @db.VarChar(1000)
  revision       Int                @default(0)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  expiresAt      DateTime
  events         SupportCaseEvent[]

  @@index([status, createdAt, id])
  @@index([expiresAt])
  @@index([profileId])
}

model SupportCaseEvent {
  id          String      @id
  caseId      String
  supportCase SupportCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  actorId     String?
  actor       User?       @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action      String      @db.VarChar(32)
  createdAt   DateTime    @default(now())

  @@index([caseId, createdAt])
  @@index([actorId])
}
